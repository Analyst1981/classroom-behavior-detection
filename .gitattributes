# 统一换行符，消除跨平台 CRLF/LF 警告
* text=auto eol=lf

# Windows 脚本必须保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件禁止做任何换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.avi binary
*.webm binary
*.zip binary
*.pdf binary
*.pt binary
*.pth binary
*.jar binary
