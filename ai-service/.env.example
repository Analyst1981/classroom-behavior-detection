# ===== AI 服务 =====
CBD_AI_HOST=0.0.0.0
CBD_AI_PORT=5000
CBD_CORS_ORIGINS=*

# ===== 模型 =====
# 课堂行为专用权重（由 train.py 训练后生成）。不存在时回退官方通用权重 yolov8n.pt
CBD_MODEL_WEIGHTS=models/best.pt
CBD_FALLBACK_WEIGHTS=yolov8n.pt
CBD_CONF_THRES=0.25
CBD_IOU_THRES=0.45
CBD_IMGSIZE=640
CBD_DEVICE=auto
# 置 0 可在无 PyTorch 环境下禁用演示引擎（此时检测接口返回空结果）
CBD_ALLOW_DEMO_ENGINE=1

# ===== 大模型（DeepSeek / Qwen，二选一或都填） =====
CBD_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 未配置 Key 时用本地规则引擎生成建议（保证离线可用）
CBD_LLM_ALLOW_LOCAL_FALLBACK=1

# ===== 视频 / 摄像头 =====
CBD_FFMPEG=ffmpeg
CBD_CAMERA_INDEX=0
